<article class="challenge-card">
    <div class="challenge-card-copy">
        <div class="recipe-card-meta">
            <span>@StatusLabel(Challenge.Status)</span>
            <span aria-hidden="true">·</span>
            <span>@DateLabel</span>
        </div>
        <h3><a href="@($"/desafios/{Challenge.Id}")">@Challenge.Title</a></h3>
        <p>@Challenge.Description</p>
        @if (Challenge.RequiredIngredients.Count > 0)
        {
            <p class="ingredient-line"><strong>Na bancada:</strong> @string.Join(", ", Challenge.RequiredIngredients)</p>
        }
        <a class="text-link" href="@($"/desafios/{Challenge.Id}")">Ver detalhes da prova <span aria-hidden="true">→</span></a>
    </div>
    @if (!string.IsNullOrWhiteSpace(Challenge.CoverImageUrl))
    {
        <img src="@Challenge.CoverImageUrl" alt="Ingredientes do desafio @Challenge.Title" loading="lazy" />
    }
</article>

@code {
    [Parameter, EditorRequired] public ChallengeCardResponse Challenge { get; set; } = null!;

    private string DateLabel => Challenge.Status == ChallengeStatus.Active
        ? $"até {Challenge.EndsAt:dd/MM}"
        : $"encerrado em {Challenge.EndsAt:dd/MM}";

    private static string StatusLabel(ChallengeStatus status) => status switch
    {
        ChallengeStatus.Active => "EM ANDAMENTO",
        ChallengeStatus.Closed => "ENCERRADO",
        _ => "EM BREVE"
    };
}
